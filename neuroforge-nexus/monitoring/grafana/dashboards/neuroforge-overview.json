{
  "uid": "neuroforge-overview",
  "title": "NeuroForge Nexus - Service Overview",
  "tags": ["neuroforge", "spring-boot", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP request rate", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[5m]))", "legendFormat": "requests/sec", "refId": "A"}], "datasource": {"type": "prometheus", "uid": "prometheus"}},
    {"id": 2, "type": "timeseries", "title": "HTTP 5xx rate", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "5xx/sec", "refId": "A"}], "datasource": {"type": "prometheus", "uid": "prometheus"}},
    {"id": 3, "type": "timeseries", "title": "HTTP request duration p95", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95 seconds", "refId": "A"}], "datasource": {"type": "prometheus", "uid": "prometheus"}},
    {"id": 4, "type": "timeseries", "title": "JVM memory used", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"expr": "sum(jvm_memory_used_bytes)", "legendFormat": "used bytes", "refId": "A"}], "datasource": {"type": "prometheus", "uid": "prometheus"}}
  ],
  "annotations": {"list": []},
